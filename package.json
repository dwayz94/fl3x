{
  "name": "fl3x",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @fl3x/api & npm run dev --workspace @fl3x/web",
    "dev:web": "npm run dev --workspace @fl3x/web",
    "dev:api": "npm run dev --workspace @fl3x/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=22" }
}
