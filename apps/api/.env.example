PORT=4000
NODE_ENV=development

# Leave empty in dev to use an embedded Postgres (PGlite) stored in .pglite/
# Production (Render): the Postgres "Internal Database URL"
DATABASE_URL=

# Privy (dashboard.privy.io → App settings)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Without Privy (local only), the web app offers a dev login (/dev).
# Tier forced on dev users (none | starter | premium):
DEV_TIER=premium
# Wallet given to dev users:
DEV_WALLET=

# Comma-separated origins allowed to call the API
WEB_ORIGIN=http://localhost:3000

# invite_only | public
LAUNCH_PHASE=invite_only

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: higher Jupiter price API limits (portal.jup.ag)
JUPITER_API_KEY=
# Optional: every EVM token in linked wallets (moralis.com). Without it: native coins + major tokens via public RPCs.
MORALIS_API_KEY=
TOKEN_SYMBOL=FL3X
TOKEN_MINT=
TIER_STARTER_MIN=100000
TIER_PREMIUM_MIN=1000000

# Invites each new member gets to hand out

# Header x-admin-key for /admin routes
ADMIN_API_KEY=dev-admin-key

# Shared secret with the web app (/api/track). Same value in Vercel as INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key
# openssl rand -hex 16
ANALYTICS_SALT=dev-salt

# Optional: Twitch live status (dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public URL of this API: OAuth redirects and links to uploaded images
API_PUBLIC_URL=http://localhost:4000
# Encrypts third-party tokens (Spotify) and signs OAuth state. Long random string in prod.
CONNECTIONS_SECRET=dev-connections-secret
# Optional: Spotify "now playing" for the music widget (developer.spotify.com/dashboard)
# Redirect URI to register: <API_PUBLIC_URL>/connections/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: error reports to Sentry
SENTRY_DSN=

# Local only: keep /dev test sessions while Privy is configured (ignored in production)
DEV_LOGIN=
