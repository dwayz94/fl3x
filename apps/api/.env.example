PORT=4000
NODE_ENV=development

# Leave empty in dev to use an embedded Postgres (PGlite) stored in .pglite/
# Production (Render): the Postgres "Internal Database URL"
DATABASE_URL=

# Privy (dashboard.privy.io → App settings)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Without Privy (local only), the web app offers a dev login. Wallet shown for dev users:
DEV_WALLET=

# Comma-separated origins allowed to call the API
WEB_ORIGIN=http://localhost:3000

# invite_only | public
LAUNCH_PHASE=invite_only

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: higher Jupiter price API limits (portal.jup.ag)
JUPITER_API_KEY=
TOKEN_SYMBOL=FL3X
TOKEN_MINT=
TIER_STARTER_MIN=100000
TIER_PREMIUM_MIN=1000000

# Invites each new member gets to hand out
DEFAULT_INVITE_QUOTA=3

# Header x-admin-key for /admin routes
ADMIN_API_KEY=dev-admin-key

# Shared secret with the web app (/api/track). Same value in Vercel as INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key
# openssl rand -hex 16
ANALYTICS_SALT=dev-salt

# Optional: Twitch live status (dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
