{
  "name": "@fl3x/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "invite:create": "tsx --env-file-if-exists=.env src/scripts/create-invites.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@privy-io/node": "^0.37.0",
    "@sentry/node": "^11.10.0",
    "aws4fetch": "^1.0.20",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "viem": "^2.56.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fl3x/shared": "*",
    "@types/node": "^22",
    "@types/pg": "^8",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
