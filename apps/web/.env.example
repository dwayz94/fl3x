NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# dashboard.privy.io → App ID (public)
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only: shared with the API (INTERNAL_API_KEY) for profile analytics
INTERNAL_API_KEY=dev-internal-key

# Optional: error reports to Sentry (same project DSN for both)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Local only: use /dev test sessions instead of Privy (ignored in production)
NEXT_PUBLIC_DEV_LOGIN=
